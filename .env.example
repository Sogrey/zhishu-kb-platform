# 知枢 · 环境变量示例（复制为 .env 后按需修改）
# 开发可先 ZHISHU_DEV_STUB=1，无 GPU/模型也能跑通上传→检索→问答闭环

ZHISHU_DEV_STUB=1
APP_NAME=知枢
APP_ENV=dev
SECRET_KEY=change-me-in-production

# 无 Docker 时保持 true；有 pgvector 后改为 false 并配置下方 PG
USE_SQLITE=true
SQLITE_PATH=./data/zhishu.db

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL（USE_SQLITE=false 时生效）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=zhishu
POSTGRES_PASSWORD=zhishu
POSTGRES_DB=zhishu

# Valkey / Redis
VALKEY_URL=redis://localhost:6379/0

# 文件存储
FILES_DIR=./data/files
UPLOAD_MAX_MB=100

# AI 服务（检索/嵌入仍可 stub；问答渠道请在管理台「设置」配置）
# 默认渠道：DeepSeek / Ollama / llama.cpp / Stub —— UI 可改，落库 llm_settings
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=Qwen3-4B-Instruct-2507
# DeepSeek Key 请在设置页填写，勿提交到仓库
# DEEPSEEK_API_KEY=
TEI_EMBED_URL=http://localhost:8081
TEI_RERANK_URL=http://localhost:8082
PARSE_URL=http://localhost:8083
EMBEDDING_DIM=1024

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
